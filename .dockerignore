# Git
.git
.gitignore

# Entornos virtuales de Python
venv/
env/
.venv/

# Caché compilada de Python
__pycache__/
*.py[cod]
*$py.class

# Directorios de Machine Learning y Tracking
mlruns/

# Datos crudos y DVC
# Ignoramos la carpeta data porque DVC se encarga de descargarla
data/
data_toy/
.dvc/
.dvcignore

# IaC / GitOps / infra local: ninguna imagen de aplicacion los necesita
# en su build context (evita enviarlos al daemon de Docker sin motivo)
terraform/
kubernetes/
gitops/
localstack/

# Logs y testing
*.log
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
**/tests/

# Herramientas de calidad local (no necesarias dentro de la imagen)
.pre-commit-config.yaml
.yamllint.yaml

# IDEs y SO
.vscode/
.idea/
.DS_Store