.ruff_cache/
.coverage
htmlcov/

# Entornos de desarrollo
.vscode/
.idea/
.ipynb_checkpoints/
/data

# Terraform generates providers, modules and local state (incluye
# terraform/bootstrap/, que se aplica por separado con su propio estado).
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
# Los planes guardados (terraform plan -out) son artefactos transitorios:
# llevan embebida una copia del config y de los valores sensibles resueltos.
*.tfplan

# gitlab-ci-local (validacion local del pipeline de CI)
.gitlab-ci-local/

