FROM ghcr.io/mlflow/mlflow:v3.15.1

# curl: usado por el healthcheck de docker-compose.yml (GET /health); la
# imagen base no lo trae instalado.
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir psycopg2-binary==2.9.9

# DS-0002: no ejecutar como root. UID fijo (10001) para que coincida con el
# de las otras imagenes del proyecto y con el securityContext de
# kubernetes/base/. El servidor de MLflow solo necesita escribir en el
# directorio de artefactos (--artifacts-destination), montado como volumen.
RUN useradd --create-home --uid 10001 --shell /usr/sbin/nologin mlflow && \
    mkdir -p /mlruns && chown -R mlflow:mlflow /mlruns
USER mlflow

# DS-0026: healthcheck a nivel de imagen.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -fsS http://localhost:5000/health || exit 1
